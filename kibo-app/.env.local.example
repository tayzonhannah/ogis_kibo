# Copy to .env.local and fill in. Only the NEXT_PUBLIC_ values reach the browser.

# Browser-safe
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only — never prefix these with NEXT_PUBLIC_.
# The service-role key bypasses every RLS policy in the schema.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Phase 5 only; the app runs without these.
GEMINI_API_KEY=your_gemini_api_key
CRON_SECRET=generate_a_long_random_string
